{
  "name": "mauvais-plan",
  "version": "0.1.0",
  "private": true,
  "description": "Mauvais Plan — jeu coopératif de cambriolage pour deux joueurs en ligne",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n serveur,client -c magenta,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --define:process.env.NODE_ENV='\"production\"' --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.2.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "phaser": "3.90.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
